<%- include('header') %>

<div class="row justify-content-center">
    <div class="col-md-8 col-12">
        <h1 class="mb-4">Новая заявка</h1>

        <% if (typeof errors !== 'undefined' && errors.length) { %>
        <div class="alert alert-danger">
            <% errors.forEach(e => { %>
                <div><%= e %></div>
            <% }) %>
        </div>
        <% } %>

        <form method="POST" action="/create">
            <div class="mb-3">
                <label class="form-label" for="room_id">Помещение</label>
                <select class="form-select" id="room_id" name="room_id" required>
                    <option value="" disabled <%= form.room_id ? '' : 'selected' %>>Выберите помещение</option>
                    <% rooms.forEach(r => { %>
                        <option value="<%= r.id %>" <%= String(form.room_id || '') === String(r.id) ? 'selected' : '' %>>
                            <%= r.type %> - <%= r.name %> (<%= r.capacity %> чел.)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="date_start">Дата начала конференции</label>
                <input
                    type="date"
                    class="form-control"
                    id="date_start"
                    name="date_start"
                    value="<%= form.date_start || '' %>"
                    min="<%= new Date().toISOString().slice(0, 10) %>"
                    required
                >
            </div>

            <div class="mb-3">
                <label class="form-label" for="payment">Способ оплаты</label>
                <select class="form-select" id="payment" name="payment" required>
                    <option value="" disabled <%= form.payment ? '' : 'selected' %>>Выберите способ оплаты</option>
                    <option value="При очном посещении" <%= form.payment === 'При очном посещении' ? 'selected' : '' %>>
                        При очном посещении
                    </option>
                    <option value="Перевод по СБП" <%= form.payment === 'Перевод по СБП' ? 'selected' : '' %>>
                        Перевод по СБП
                    </option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">Отправить заявку</button>
        </form>

        <p class="mt-3 text-center">
            <a href="/dashboard">Вернуться к моим заявкам</a>
        </p>
    </div>
</div>

<%- include('footer') %>
